<Window x:Class="Pulse.Windows.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Pulse.Windows.Controls"
        mc:Ignorable="d"
        Title="Pulse Settings"
        Height="680" Width="920"
        MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#141416"
        Foreground="#EDEDED"
        FontFamily="Segoe UI Variable, Segoe UI, -apple-system, sans-serif"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="True"
        Icon="/Resources/app_icon.png"
        ResizeMode="CanResizeWithGrip">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" CornerRadius="12" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Minimal Anti-slop ScrollBar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#2E2E34" CornerRadius="3" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS Style Toggle Switch -->
        <Style x:Key="MacToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="38" Height="22" CornerRadius="11" Background="#2C2C30" Padding="2">
                            <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="#FAFAFA" HorizontalAlignment="Left">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTransform" X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#007AFF"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Button Style -->
        <Style x:Key="SegmentButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="BtnBorder" Background="Transparent" Padding="12,5" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#007AFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#2A2A30"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar List Item Style -->
        <Style x:Key="SidebarItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="6,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#007AFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#222228"/>
                                <Setter Property="Foreground" Value="#FAFAFA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS Rounded Card Style -->
        <Style x:Key="MacCardBorder" TargetType="Border">
            <Setter Property="Background" Value="#1A1A1E"/>
            <Setter Property="BorderBrush" Value="#26262B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Secondary Action Button -->
        <Style x:Key="MacSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#24242A"/>
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="BorderBrush" Value="#32323A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#2E2E36"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#1C1C22"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Window Outer Border -->
    <Border Background="#141416" BorderBrush="#28282E" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0" Background="#18181C" BorderBrush="#24242A" BorderThickness="0,0,1,0" CornerRadius="12,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- macOS Traffic Lights & Window Drag Header -->
                    <Grid Grid.Row="0" Height="38" Margin="14,0,14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Close Button (Red) -->
                            <Button x:Name="CloseWindowBtn" Width="12" Height="12" Margin="0,0,8,0" Background="#FF5F56" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Ellipse Fill="{TemplateBinding Background}"/>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <!-- Minimize Button (Yellow) -->
                            <Button x:Name="MinWindowBtn" Width="12" Height="12" Margin="0,0,8,0" Background="#FFBD2E" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Ellipse Fill="{TemplateBinding Background}"/>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <!-- Maximize Button (Green) -->
                            <Button x:Name="MaxWindowBtn" Width="12" Height="12" Background="#27C93F" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Ellipse Fill="{TemplateBinding Background}"/>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Search Box -->
                    <Border Grid.Row="1" Background="#222228" BorderBrush="#2C2C34" BorderThickness="1" CornerRadius="8" Margin="12,0,12,10" Padding="8,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="11" Foreground="#71717A" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="SidebarSearchBox" Grid.Column="1" Background="Transparent" Foreground="#FAFAFA" BorderThickness="0" FontSize="12" VerticalAlignment="Center" TextChanged="SidebarSearchBox_TextChanged">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Style.Resources>
                                            <VisualBrush x:Key="CueBannerBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                <VisualBrush.Visual>
                                                    <Label Content="Search" Foreground="#71717A" Padding="0" FontSize="12"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Style.Resources>
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background" Value="{StaticResource CueBannerBrush}"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="{x:Null}">
                                                <Setter Property="Background" Value="{StaticResource CueBannerBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                    </Border>

                    <!-- Navigation Items List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="SidebarNavContainer" Margin="0,0,0,12">
                            <!-- PANEL SECTION -->
                            <TextBlock Text="Panel" FontSize="11" FontWeight="SemiBold" Foreground="#71717A" Margin="16,6,16,4"/>
                            <ListBox x:Name="PanelNavList" Background="Transparent" BorderThickness="0" SelectionChanged="OnNavSelectionChanged">
                                <ListBoxItem Style="{StaticResource SidebarItemStyle}" Tag="General" IsSelected="True">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚙" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="General" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Style="{StaticResource SidebarItemStyle}" Tag="TokenSpend">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📊" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Token spend" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>
                            </ListBox>

                            <!-- ACCOUNTS SECTION -->
                            <TextBlock Text="Accounts" FontSize="11" FontWeight="SemiBold" Foreground="#71717A" Margin="16,14,16,4"/>
                            <ListBox x:Name="AccountsNavList" Background="Transparent" BorderThickness="0" SelectionChanged="OnNavSelectionChanged">
                                <ListBoxItem Style="{StaticResource SidebarItemStyle}" Tag="Antigravity">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▲" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#4285F4"/>
                                        <TextBlock Text="Antigravity" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Style="{StaticResource SidebarItemStyle}" Tag="ClaudeCode">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✳" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#D97706"/>
                                        <TextBlock Text="Claude Code" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Style="{StaticResource SidebarItemStyle}" Tag="Codex">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="◎" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#10B981"/>
                                        <TextBlock Text="Codex" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Style="{StaticResource SidebarItemStyle}" Tag="CommandCode">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⌘" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Command Code" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Style="{StaticResource SidebarItemStyle}" Tag="Cursor">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🧊" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Cursor" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Style="{StaticResource SidebarItemStyle}" Tag="DeepSeek">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🐋" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="DeepSeek" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Style="{StaticResource SidebarItemStyle}" Tag="Devin">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚙" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Devin" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Style="{StaticResource SidebarItemStyle}" Tag="Copilot">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🐱" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="GitHub Copilot" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Style="{StaticResource SidebarItemStyle}" Tag="Grok">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⊘" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Grok" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Style="{StaticResource SidebarItemStyle}" Tag="GrokBot">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚔" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Grok Bot" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Style="{StaticResource SidebarItemStyle}" Tag="KimiCode">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="𝙆" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Kimi Code" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Style="{StaticResource SidebarItemStyle}" Tag="MiniMax">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="〰" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="MiniMax" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Style="{StaticResource SidebarItemStyle}" Tag="MiniMaxCN">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="〰" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="MiniMax CN" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Style="{StaticResource SidebarItemStyle}" Tag="OllamaCloud">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🦙" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Ollama Cloud" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Style="{StaticResource SidebarItemStyle}" Tag="OpenCodeGo">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📱" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="OpenCode Go" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Style="{StaticResource SidebarItemStyle}" Tag="Volcengine">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🌋" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Volcengine" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Style="{StaticResource SidebarItemStyle}" Tag="Zai">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="𝐙" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="z.ai" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Style="{StaticResource SidebarItemStyle}" Tag="Zhipu">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🧠" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Zhipu" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>
                            </ListBox>

                            <!-- APPLICATION SECTION -->
                            <TextBlock Text="Application" FontSize="11" FontWeight="SemiBold" Foreground="#71717A" Margin="16,14,16,4"/>
                            <ListBox x:Name="AppNavList" Background="Transparent" BorderThickness="0" SelectionChanged="OnNavSelectionChanged">
                                <ListBoxItem Style="{StaticResource SidebarItemStyle}" Tag="Integrations">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💻" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Developer integrations" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Style="{StaticResource SidebarItemStyle}" Tag="About">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ℹ" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="About" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Sidebar Footer with Quit Button -->
                    <Border Grid.Row="3" BorderBrush="#24242A" BorderThickness="0,1,0,0" Padding="12,10">
                        <Button x:Name="SidebarQuitBtn" Content="Quit Pulse"
                                Style="{StaticResource MacSecondaryButton}"
                                Foreground="#F87171" BorderBrush="#3B1C1C" Background="#201414"
                                HorizontalAlignment="Stretch" Cursor="Hand" Click="SidebarQuitBtn_Click"
                                ToolTip="Quit Pulse and terminate background process (Ctrl+Q)"/>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT CONTENT PANE -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Header Bar -->
                <Border Grid.Row="0" Background="#141416" BorderBrush="#222228" BorderThickness="0,0,0,1" Padding="24,0">
                    <Grid VerticalAlignment="Center">
                        <TextBlock x:Name="TopHeaderTitle" Text="Pulse Settings" FontSize="14" FontWeight="SemiBold" Foreground="#FAFAFA"/>
                    </Grid>
                </Border>

                <!-- Dynamic Panes Scroll Area -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,20,28,24">
                    <StackPanel>
                        <!-- ============================================== -->
                        <!-- 1. GENERAL PANE (Matches Screenshot 1)          -->
                        <!-- ============================================== -->
                        <StackPanel x:Name="GeneralPaneView" Visibility="Visible">
                            <TextBlock Text="General" FontSize="20" FontWeight="Bold" Foreground="#FAFAFA" Margin="0,0,0,16"/>
                            <TextBlock Text="Floating panel" FontSize="13" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,0,0,12"/>

                            <!-- Options List (White Card with Dividers) -->
                            <Border Style="{StaticResource MacCardBorder}" Padding="0">
                                <StackPanel>
                                    <!-- 1. Show floating panel -->
                                    <Grid Margin="16,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Show floating panel" FontSize="13" FontWeight="Medium" Foreground="#FAFAFA"/>
                                            <TextBlock Text="The usage rail at the edge of the screen." FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ShowFloatingPanelSwitch" Grid.Column="1" Style="{StaticResource MacToggleSwitch}" IsChecked="True" Checked="SaveSettingsField" Unchecked="SaveSettingsField"/>
                                    </Grid>
                                    <Separator Background="#24242A" Margin="16,0"/>

                                    <!-- 2. Hide in full screen -->
                                    <Grid Margin="16,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Hide in full screen" FontSize="13" FontWeight="Medium" Foreground="#FAFAFA"/>
                                            <TextBlock Text="Keep the floating panel out of full-screen apps." FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="HideInFullScreenSwitch" Grid.Column="1" Style="{StaticResource MacToggleSwitch}" IsChecked="True" Checked="SaveSettingsField" Unchecked="SaveSettingsField"/>
                                    </Grid>
                                    <Separator Background="#24242A" Margin="16,0"/>

                                    <!-- 3. Size -->
                                    <Grid Margin="16,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Size" FontSize="13" FontWeight="Medium" Foreground="#FAFAFA"/>
                                            <TextBlock Text="Size of the rail on screen." FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#24242A" BorderBrush="#32323A" BorderThickness="1" CornerRadius="6" Padding="2">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="SizeSmallRadio" Content="Small" GroupName="SizeGroup" Style="{StaticResource SegmentButton}" Checked="SaveSettingsField"/>
                                                <RadioButton x:Name="SizeStandardRadio" Content="Standard" GroupName="SizeGroup" Style="{StaticResource SegmentButton}" IsChecked="True" Checked="SaveSettingsField"/>
                                                <RadioButton x:Name="SizeLargeRadio" Content="Large" GroupName="SizeGroup" Style="{StaticResource SegmentButton}" Checked="SaveSettingsField"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Separator Background="#24242A" Margin="16,0"/>

                                    <!-- 4. Spacing -->
                                    <Grid Margin="16,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Spacing" FontSize="13" FontWeight="Medium" Foreground="#FAFAFA"/>
                                            <TextBlock Text="How much air there is between the rings." FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#24242A" BorderBrush="#32323A" BorderThickness="1" CornerRadius="6" Padding="2">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="SpacingTightRadio" Content="Tight" GroupName="SpacingGroup" Style="{StaticResource SegmentButton}" Checked="SaveSettingsField"/>
                                                <RadioButton x:Name="SpacingStandardRadio" Content="Standard" GroupName="SpacingGroup" Style="{StaticResource SegmentButton}" IsChecked="True" Checked="SaveSettingsField"/>
                                                <RadioButton x:Name="SpacingLooseRadio" Content="Loose" GroupName="SpacingGroup" Style="{StaticResource SegmentButton}" Checked="SaveSettingsField"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Separator Background="#24242A" Margin="16,0"/>

                                    <!-- 5. Liquid Glass -->
                                    <Grid Margin="16,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Liquid Glass" FontSize="13" FontWeight="Medium" Foreground="#FAFAFA"/>
                                            <TextBlock Text="Frosted glass instead of solid black." FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="LiquidGlassSwitch" Grid.Column="1" Style="{StaticResource MacToggleSwitch}" IsChecked="False" Checked="SaveSettingsField" Unchecked="SaveSettingsField"/>
                                    </Grid>
                                    <Separator Background="#24242A" Margin="16,0"/>

                                    <!-- 6. Hide until pointed at -->
                                    <Grid Margin="16,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Hide until pointed at" FontSize="13" FontWeight="Medium" Foreground="#FAFAFA"/>
                                            <TextBlock Text="Against a screen edge, the rail shrinks to a sliver until you point at it." FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="HideUntilPointedAtSwitch" Grid.Column="1" Style="{StaticResource MacToggleSwitch}" IsChecked="False" Checked="SaveSettingsField" Unchecked="SaveSettingsField"/>
                                    </Grid>
                                    <Separator Background="#24242A" Margin="16,0"/>

                                    <!-- 7. Position -->
                                    <Grid Margin="16,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Position" FontSize="13" FontWeight="Medium" Foreground="#FAFAFA"/>
                                            <TextBlock Text="Drag it anywhere; near an edge it snaps on." FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#24242A" BorderBrush="#32323A" BorderThickness="1" CornerRadius="6" Padding="2">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="PosLeftRadio" Content="Left" GroupName="PosGroup" Style="{StaticResource SegmentButton}" Checked="SaveSettingsField"/>
                                                <RadioButton x:Name="PosTopRadio" Content="Top" GroupName="PosGroup" Style="{StaticResource SegmentButton}" Checked="SaveSettingsField"/>
                                                <RadioButton x:Name="PosFreeRadio" Content="Free" GroupName="PosGroup" Style="{StaticResource SegmentButton}" Checked="SaveSettingsField"/>
                                                <RadioButton x:Name="PosRightRadio" Content="Right" GroupName="PosGroup" Style="{StaticResource SegmentButton}" IsChecked="True" Checked="SaveSettingsField"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Separator Background="#24242A" Margin="16,0"/>

                                    <!-- 8. Follow the active display -->
                                    <Grid Margin="16,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Follow the active display" FontSize="13" FontWeight="Medium" Foreground="#FAFAFA"/>
                                            <TextBlock Text="With more than one display, the rail moves to the one the pointer is on." FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="FollowActiveDisplaySwitch" Grid.Column="1" Style="{StaticResource MacToggleSwitch}" IsChecked="False" Checked="SaveSettingsField" Unchecked="SaveSettingsField"/>
                                    </Grid>
                                    <Separator Background="#24242A" Margin="16,0"/>

                                    <!-- 9. Percentages at the side -->
                                    <Grid Margin="16,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Percentages at the side" FontSize="13" FontWeight="Medium" Foreground="#FAFAFA"/>
                                            <TextBlock Text="The figure under each ring, docked left or right." FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="PercentagesAtSideSwitch" Grid.Column="1" Style="{StaticResource MacToggleSwitch}" IsChecked="True" Checked="SaveSettingsField" Unchecked="SaveSettingsField"/>
                                    </Grid>
                                    <Separator Background="#24242A" Margin="16,0"/>

                                    <!-- 10. Theme Appearance -->
                                    <Grid Margin="16,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Theme" FontSize="13" FontWeight="Medium" Foreground="#FAFAFA"/>
                                            <TextBlock Text="Select aesthetic appearance (Dark, White, Purple, Glass)." FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#24242A" BorderBrush="#32323A" BorderThickness="1" CornerRadius="6" Padding="2">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="ThemeDarkRadio" Content="Dark" GroupName="ThemeGroup" Style="{StaticResource SegmentButton}" IsChecked="True" Checked="SaveSettingsField"/>
                                                <RadioButton x:Name="ThemeLightRadio" Content="White" GroupName="ThemeGroup" Style="{StaticResource SegmentButton}" Checked="SaveSettingsField"/>
                                                <RadioButton x:Name="ThemePurpleRadio" Content="Purple" GroupName="ThemeGroup" Style="{StaticResource SegmentButton}" Checked="SaveSettingsField"/>
                                                <RadioButton x:Name="ThemeGlassRadio" Content="Glass" GroupName="ThemeGroup" Style="{StaticResource SegmentButton}" Checked="SaveSettingsField"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============================================== -->
                        <!-- 2. PROVIDER DETAIL PANE (Screenshots 2 & 3)     -->
                        <!-- ============================================== -->
                        <StackPanel x:Name="ProviderPaneView" Visibility="Collapsed">
                            <!-- Accounts Section -->
                            <TextBlock Text="Accounts" FontSize="13" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,0,0,8"/>
                            <Border Style="{StaticResource MacCardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Add another account" FontSize="13" FontWeight="Medium" Foreground="#FAFAFA"/>
                                        <TextBlock Text="Opens the provider's own sign-in page." FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="ProviderSignInBtn" Grid.Column="1" Content="Sign in..." Style="{StaticResource MacSecondaryButton}" Click="ProviderSignInBtn_Click"/>
                                </Grid>
                            </Border>

                            <!-- Connected Accounts List (if multi-account) -->
                            <StackPanel x:Name="MultiAccountsContainer" Margin="0,0,0,16" Visibility="Collapsed">
                                <TextBlock Text="Connected accounts" FontSize="12" FontWeight="SemiBold" Foreground="#71717A" Margin="0,0,0,6"/>
                                <StackPanel x:Name="MultiAccountsList"/>
                            </StackPanel>

                            <!-- Current Usage Section -->
                            <TextBlock Text="Current usage" FontSize="13" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,0,0,8"/>
                            <Border Style="{StaticResource MacCardBorder}">
                                <StackPanel>
                                    <!-- Last Read Row -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Last read" FontSize="12" Foreground="#A1A1AA" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ProviderLastReadText" Grid.Column="1" Text="Just now" FontSize="12" Foreground="#71717A" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <Button x:Name="ProviderRefreshBtn" Grid.Column="2" Content="Refresh" Style="{StaticResource MacSecondaryButton}" Click="ProviderRefreshBtn_Click"/>
                                    </Grid>

                                    <Separator Background="#24242A" Margin="0,0,0,12"/>

                                    <!-- Dynamic Limit Windows (5h, weekly, scoped) -->
                                    <StackPanel x:Name="ProviderWindowsContainer">
                                        <!-- Rows added programmatically -->
                                    </StackPanel>

                                    <!-- Plan Row -->
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Plan" FontSize="12" Foreground="#A1A1AA"/>
                                        <TextBlock x:Name="ProviderPlanText" Grid.Column="1" Text="Standard Quota" FontSize="12" Foreground="#D4D4D8" FontWeight="Medium"/>
                                    </Grid>

                                    <!-- Credit Balance Row (if available) -->
                                    <Grid x:Name="ProviderCreditRow" Margin="0,8,0,0" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Credit balance" FontSize="12" Foreground="#A1A1AA"/>
                                        <TextBlock x:Name="ProviderCreditText" Grid.Column="1" Text="2500" FontSize="12" Foreground="#D4D4D8" FontWeight="Medium"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Estimated Value Section (Only shown when valid estimates exist; hidden when empty) -->
                            <StackPanel x:Name="EstimatedValueSection" Visibility="Collapsed">
                                <TextBlock Text="Estimated value" FontSize="13" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,0,0,8"/>
                                <Border Style="{StaticResource MacCardBorder}">
                                    <StackPanel x:Name="EstimatedValueRowsContainer">
                                        <!-- Dynamic rows if estimates exist -->
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Usage History Section (1:1 with macOS Pulse) -->
                            <StackPanel x:Name="UsageHistorySection">
                                <TextBlock Text="Usage history" FontSize="13" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="0,0,0,8"/>

                                <!-- No History Card (Shown when no local ledger records exist) -->
                                <Border x:Name="NoHistoryCard" Style="{StaticResource MacCardBorder}" Padding="16,14" Visibility="Visible">
                                    <StackPanel>
                                        <TextBlock Text="No history yet" FontSize="13" FontWeight="SemiBold" Foreground="#FAFAFA"/>
                                        <TextBlock Text="No usage recorded on this machine yet." FontSize="11" Foreground="#71717A" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Live History Card (Shown only when real ledger data exists) -->
                                <Border x:Name="LiveHistoryCard" Style="{StaticResource MacCardBorder}" Visibility="Collapsed">
                                    <StackPanel>
                                        <!-- 4-Stat Grid -->
                                        <UniformGrid Columns="4" Margin="0,0,0,16">
                                            <StackPanel>
                                                <TextBlock Text="Today" FontSize="11" Foreground="#71717A"/>
                                                <TextBlock x:Name="HistTodaySpend" Text="$0.00" FontSize="14" FontWeight="SemiBold" Foreground="#FAFAFA" Margin="0,2,0,0"/>
                                                <TextBlock x:Name="HistTodayTokens" Text="0 tokens" FontSize="10" Foreground="#52525B"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Last 31 days" FontSize="11" Foreground="#71717A"/>
                                                <TextBlock x:Name="HistMonthSpend" Text="$0.00" FontSize="14" FontWeight="SemiBold" Foreground="#FAFAFA" Margin="0,2,0,0"/>
                                                <TextBlock x:Name="HistMonthTokens" Text="0 tokens" FontSize="10" Foreground="#52525B"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Busiest day" FontSize="11" Foreground="#71717A"/>
                                                <TextBlock x:Name="HistBusiestSpend" Text="$0.00" FontSize="14" FontWeight="SemiBold" Foreground="#FAFAFA" Margin="0,2,0,0"/>
                                                <TextBlock x:Name="HistBusiestTokens" Text="0 tokens" FontSize="10" Foreground="#52525B"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="All time" FontSize="11" Foreground="#71717A"/>
                                                <TextBlock x:Name="HistAllTimeSpend" Text="$0.00" FontSize="14" FontWeight="SemiBold" Foreground="#FAFAFA" Margin="0,2,0,0"/>
                                                <TextBlock x:Name="HistAllTimeTokens" Text="0 tokens" FontSize="10" Foreground="#52525B"/>
                                            </StackPanel>
                                        </UniformGrid>

                                        <!-- 30-Day Blue Bar Chart -->
                                        <Border Height="64" Background="#141418" BorderBrush="#222228" BorderThickness="1" CornerRadius="6" Padding="4,8" Margin="0,0,0,10">
                                            <Canvas x:Name="UsageBarChartCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                        </Border>

                                        <!-- Top Model Line -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Top model" FontSize="11" Foreground="#71717A"/>
                                            <TextBlock x:Name="HistTopModelText" Grid.Column="1" Text="None" FontSize="11" Foreground="#A1A1AA"/>
                                        </Grid>

                                        <TextBlock Text="Counted from this machine's logs and priced at the published API rates from models.dev. Your plan is a subscription, so this is what the same work would cost through the API — not what you were charged."
                                                   FontSize="10.5" Foreground="#52525B" TextWrapping="Wrap" LineHeight="14"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- ============================================== -->
                        <!-- 3. TOKEN SPEND PANE                           -->
                        <!-- ============================================== -->
                        <StackPanel x:Name="TokenSpendPaneView" Visibility="Collapsed">
                            <TextBlock Text="Token spend" FontSize="20" FontWeight="Bold" Foreground="#FAFAFA" Margin="0,0,0,16"/>

                            <Border Style="{StaticResource MacCardBorder}" Padding="16,14">
                                <StackPanel>
                                    <TextBlock Text="No usage records found" FontSize="13" FontWeight="SemiBold" Foreground="#FAFAFA"/>
                                    <TextBlock Text="Token records are read from local CLI transcripts and exports. When coding sessions are recorded on this machine, token spend and breakdowns will appear here."
                                               FontSize="11" Foreground="#71717A" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============================================== -->
                        <!-- 4. DEVELOPER INTEGRATIONS PANE                 -->
                        <!-- ============================================== -->
                        <StackPanel x:Name="IntegrationsPaneView" Visibility="Collapsed">
                            <TextBlock Text="Developer integrations" FontSize="20" FontWeight="Bold" Foreground="#FAFAFA" Margin="0,0,0,16"/>
                            <Border Style="{StaticResource MacCardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Status Line Hooks" FontSize="14" FontWeight="SemiBold" Foreground="#FAFAFA" Margin="0,0,0,6"/>
                                    <TextBlock Text="Capture real-time token spend directly from Claude Code, Codex, and terminal LLMs." FontSize="12" Foreground="#71717A" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <Button x:Name="InstallHooksBtn" Content="Install Statusline Hooks" Style="{StaticResource MacSecondaryButton}" HorizontalAlignment="Left" Click="InstallHooksBtn_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource MacCardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Network &amp; Proxy" FontSize="14" FontWeight="SemiBold" Foreground="#FAFAFA" Margin="0,0,0,6"/>
                                    <TextBlock Text="Configure HTTP/SOCKS proxy for API quota queries if required by your network." FontSize="12" Foreground="#71717A" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ProxyHostInput" Background="#222228" Foreground="#FAFAFA" BorderBrush="#2C2C34" Padding="8,6" Margin="0,0,8,0" Text="127.0.0.1"/>
                                        <TextBox x:Name="ProxyPortInput" Grid.Column="1" Background="#222228" Foreground="#FAFAFA" BorderBrush="#2C2C34" Padding="8,6" Text="7890"/>
                                    </Grid>
                                    <Button Content="Save Proxy Settings" Style="{StaticResource MacSecondaryButton}" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============================================== -->
                        <!-- 5. ABOUT PANE                                  -->
                        <!-- ============================================== -->
                        <StackPanel x:Name="AboutPaneView" Visibility="Collapsed">
                            <TextBlock Text="About" FontSize="20" FontWeight="Bold" Foreground="#FAFAFA" Margin="0,0,0,16"/>
                            <Border Style="{StaticResource MacCardBorder}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Image Source="/Resources/app_icon.png" Width="48" Height="48" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Pulse for Windows" FontSize="16" FontWeight="SemiBold" Foreground="#FAFAFA"/>
                                            <TextBlock Text="Version 0.1 (Native Windows)" FontSize="11" Foreground="#71717A"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="Real-time multi-account AI model usage rail, quota monitoring, and token spend tracking." FontSize="12" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                    <TextBlock Text="Faithfully ported from the original macOS Pulse application with native Windows integration." FontSize="11" Foreground="#71717A" TextWrapping="Wrap" Margin="0,0,0,16"/>
                                    <Button x:Name="AboutQuitBtn" Content="Quit Pulse Application"
                                            Style="{StaticResource MacSecondaryButton}"
                                            Foreground="#F87171" BorderBrush="#3B1C1C" Background="#201414"
                                            HorizontalAlignment="Left" Padding="14,6" Cursor="Hand" Click="SidebarQuitBtn_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
