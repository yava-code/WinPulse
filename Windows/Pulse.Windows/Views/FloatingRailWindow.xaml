<Window x:Class="Pulse.Windows.Views.FloatingRailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Pulse.Windows.Controls"
        mc:Ignorable="d"
        Title="Pulse Rail"
        Height="620" Width="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#18181C"/>
            <Setter Property="BorderBrush" Value="#2C2C34"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#18181C" BorderBrush="#2C2C34" BorderThickness="1" CornerRadius="8" Padding="4">
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuItemBorder" Background="Transparent" CornerRadius="5" Padding="14,6" Margin="0,1">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemBorder" Property="Background" Value="#282830"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#26262B" Margin="6,3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Canvas x:Name="RootCanvas" Width="360" Height="620" Background="{x:Null}">
        <!-- Detail Card Overlay (positions beside hovered ring) -->
        <controls:DetailCardPopup x:Name="DetailPopup" Visibility="Collapsed"
                                  Canvas.Right="72" Canvas.Top="20" />

        <!-- Floating / Docked Rail Body (Authentic 64px macOS Capsule) -->
        <Border x:Name="RailContainer" Canvas.Right="0" Canvas.Top="20"
                Width="64"
                Background="{DynamicResource ThemeRailBackground}"
                BorderBrush="{DynamicResource ThemeRailBorderBrush}"
                BorderThickness="1"
                CornerRadius="32" Padding="0,18"
                Cursor="SizeAll">
            <Grid>
                <!-- Full Rail Contents (rings stack) -->
                <StackPanel x:Name="RingsStack" Orientation="Vertical">
                    <!-- Dynamically populated UsageRingControls -->
                </StackPanel>

                <!-- Collapsed Edge Sliver Bar (smoothly fades in on edge) -->
                <Border x:Name="SliverBar" Width="6" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                        CornerRadius="3" Background="#30D158" Visibility="Collapsed" Opacity="0" />
            </Grid>
        </Border>
    </Canvas>
</Window>
