<UserControl x:Class="Pulse.Windows.Controls.UsageRingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:Pulse.Windows.Controls"
             mc:Ignorable="d" 
             Cursor="Hand"
             Background="Transparent">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Circular Ring Canvas (concentric 40x40 with 36px ring and 24px mascot face) -->
        <Canvas x:Name="RingCanvas" Width="40" Height="40" Grid.Row="0" HorizontalAlignment="Center">
            <!-- Background Track -->
            <Ellipse x:Name="TrackEllipse" Width="36" Height="36" Canvas.Left="2" Canvas.Top="2"
                     Stroke="#1C1C20" StrokeThickness="4.0" />

            <!-- Animated Progress Arc -->
            <Path x:Name="ProgressArcPath" Canvas.Left="2" Canvas.Top="2"
                  Stroke="#30D158" StrokeThickness="4.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                <Path.Effect>
                    <DropShadowEffect x:Name="GlowEffect" BlurRadius="6" ShadowDepth="0" Color="#30D158" Opacity="0.35"/>
                </Path.Effect>
            </Path>

            <!-- Center BotMark Vector Animated Mascot Face (1:1 Physics & Morphing) -->
            <controls:BotMarkControl x:Name="BotMark" Width="24" Height="24" Canvas.Left="8" Canvas.Top="8"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Canvas>

        <!-- Percentage Label Below Ring -->
        <TextBlock x:Name="PercentLabel" Grid.Row="1" Text="0%" FontSize="11" FontWeight="Medium"
                   Foreground="#D4D4D8" HorizontalAlignment="Center" Margin="0,5,0,0" />
    </Grid>
</UserControl>
